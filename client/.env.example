# Optional. Without these the app works as a guest and keeps progress
# in the browser only. See "Accounts" in the root README.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to true only after enabling the Google provider in Supabase.
VITE_GOOGLE_AUTH=false
